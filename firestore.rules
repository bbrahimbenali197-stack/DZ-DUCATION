rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /missions_progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /quiz_results/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /favorites/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /badges/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /certificates/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /orders/{userId} {
      allow create, read, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Les codes PVC ne doivent pas être accessibles directement depuis le navigateur.
    // Leur validation devra passer par un backend/Cloud Function.
    match /access_codes/{codeId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
